# Copy this file to .env. Secrets are used only by the backend.
DEMO_MODE=true
POSTGRES_DB=forma
POSTGRES_USER=forma
POSTGRES_PASSWORD=forma_local_demo
# Local run uses SQLite by default. Docker Compose overrides DATABASE_URL.
DATABASE_URL=sqlite:///./demo.db
# Required (24+ chars) with DEMO_MODE=false. Enter in Settings in the UI.
ADMIN_API_KEY=

# OpenAI-compatible Chat Completions endpoint; leave empty for local lexical RAG.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MANAGER_CHAT_ID=
PUBLIC_BASE_URL=
